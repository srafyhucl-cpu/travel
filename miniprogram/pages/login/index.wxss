.brand {
  padding: 110rpx 24rpx 24rpx;
  text-align: center;
}

.logo {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 26rpx;
  border-radius: 32rpx;
  background: var(--accent-gradient);
  box-shadow: 0 10rpx 30rpx rgba(43, 119, 229, 0.38);
  color: #ffffff;
  font-size: 50rpx;
  line-height: 108rpx;
  font-weight: 700;
}

.title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.lead {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.form {
  margin-top: 24rpx;
  padding: 24rpx 32rpx 36rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow-elevated), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.hint {
  margin-top: 10rpx;
}

.foot {
  margin-top: 44rpx;
  text-align: center;
}
