/* 总预算：与记账页同款表单语言 */
.form {
  padding: 12rpx 32rpx 40rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.form-title {
  padding: 26rpx 0 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  border-bottom: 2rpx solid var(--line);
  padding-bottom: 8rpx;
  margin-top: 10rpx;
}

.amount-cur {
  flex: none;
  margin-right: 14rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 120rpx;
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 120rpx;
  font-variant-numeric: tabular-nums;
}

.amount-ph {
  color: var(--ink-3);
  font-weight: 700;
}

.stat-line {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

button.btn-primary[disabled] {
  background: var(--surface-2);
  color: var(--ink-3);
  box-shadow: none;
  opacity: 0.6;
}

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
