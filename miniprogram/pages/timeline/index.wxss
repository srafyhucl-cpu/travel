/* 时间线：自定义导航栏 + 总结卡 + 按天卡片 + 长按拖动 v2 + 落点确认面板。
   颜色全走 app.wxss 的 tokens（深色自适应）。 */

/* ---------- ① 自定义导航栏 ---------- */

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--glass-bg);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-bottom: 1rpx solid var(--line);
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
}

/* 左：我的（给中线的标题让出对称的位置感，右侧靠胶囊留白约束） */
.nav-left {
  position: relative;
  z-index: 2;
  margin-left: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
  transition: opacity 120ms ease, transform 120ms ease;
}

.nav-press {
  opacity: 0.75;
  transform: scale(0.96);
}

/* 中：行程名居中、单行、字号由页面按长度给（max-width 让长名字出省略号） */
.nav-title {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- ② 总结卡 ---------- */

.sum-card {
  position: relative;
  background: var(--hero-bg);
  border-radius: var(--radius);
  padding: 30rpx 30rpx 26rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow-elevated), var(--card-highlight);
  box-sizing: border-box;
  overflow: hidden;
}

.sum-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 24rpx;
  right: 24rpx;
  height: 2rpx;
  background: var(--accent-gradient);
  opacity: 0.65;
}

.sum-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.sum-status {
  flex: none;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  border: 1rpx solid rgba(43, 119, 229, 0.22);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.sum-status.tone-done {
  background: rgba(16, 185, 129, 0.12);
  color: var(--ok);
  border-color: rgba(16, 185, 129, 0.25);
}

.sum-dates {
  font-size: 23rpx;
  font-weight: 500;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

/* 前置准备不在这里：它是顶部那张独立的「出行准备」卡（见 .prep-card） */

.sum-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -0.6rpx;
  color: var(--ink);
}

.sum-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
}

/* 整体进度：已完成项数 / 总项数 */
.sum-bar {
  margin-top: 22rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  overflow: hidden;
}

.sum-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent-gradient);
  box-shadow: 0 2rpx 8rpx rgba(43, 119, 229, 0.35);
}

.sum-bar-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

/* 三格统计：独立微卡片网格布局，高对比数据排版 */
.sum-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.sum-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 8rpx;
  border-radius: 20rpx;
  background: var(--stat-card-bg);
  border: var(--stat-card-border);
  box-sizing: border-box;
  transition: opacity 120ms ease, background-color 120ms ease, transform 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.stat-press {
  opacity: 0.75;
  transform: scale(0.96);
  background: var(--surface-2);
}

.sum-stat.on {
  background: var(--accent-soft);
  border-color: var(--accent);
  box-shadow: 0 0 0 1rpx var(--accent), 0 4rpx 16rpx rgba(43, 119, 229, 0.2);
}

.ss-num {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.ss-num.danger {
  color: var(--danger);
}

.ss-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 0.2rpx;
}

.sum-stat.over {
  border-color: rgba(226, 87, 76, 0.35);
  background: rgba(226, 87, 76, 0.06);
}

.sum-stat.over .ss-label {
  color: var(--danger);
}

.flag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  border: 1rpx solid rgba(43, 119, 229, 0.2);
  font-size: 22rpx;
  font-weight: 600;
}

.flag.off {
  background: rgba(226, 87, 76, 0.12);
  color: var(--danger);
  border-color: rgba(226, 87, 76, 0.25);
}

/* ---------- 天分组 ---------- */
/* ---------- ②′ 出行准备：不属于任何一天，单独一张清单卡 ---------- */

.prep-card {
  margin-top: 20rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx 26rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  box-sizing: border-box;
}

.prep-card.alldone {
  border-color: rgba(39, 174, 96, 0.3);
}

/* 卡片头整行可点：展开/收起，右侧给一个明说「展开 / 收起」的小胶囊 */
.prep-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.prep-press {
  opacity: 0.8;
  transform: scale(0.985);
}

.prep-ic {
  width: 38rpx;
  height: 38rpx;
  flex: none;
}

.prep-main {
  flex: 1;
  min-width: 0;
}

.prep-title {
  font-size: 31rpx;
  font-weight: 700;
}

.prep-note {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.prep-card.alldone .prep-note {
  color: var(--ok);
  font-weight: 600;
}

.prep-count {
  flex: none;
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.prep-toggle {
  flex: none;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 500;
}

.prep-bar {
  margin-top: 16rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  overflow: hidden;
}

.prep-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent-gradient);
}

.prep-card.alldone .prep-fill {
  background: var(--ok-gradient);
}

.prep-body {
  margin-top: 12rpx;
  border-top: 2rpx solid var(--line);
  padding-top: 10rpx;
}

.prep-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--line);
}

.prep-tip {
  font-size: 23rpx;
  color: var(--ink-3);
}

.prep-edit {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--accent);
  padding: 8rpx 14rpx;
  margin: -8rpx -14rpx;
}

.day {
  margin-top: 26rpx;
}

.day-mark {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 6rpx 16rpx;
}

.dm-date {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  font-variant-numeric: tabular-nums;
}

.day-mark.today .dm-date {
  color: var(--accent);
  text-shadow: 0 0 16rpx rgba(43, 119, 229, 0.35);
}

.dm-rel {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-3);
}

.dm-count {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.day-mark.today .dm-count {
  background: var(--accent-soft);
  border-color: rgba(43, 119, 229, 0.25);
  color: var(--accent);
}

.day-empty {
  padding: 24rpx 24rpx;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius);
  color: var(--ink-3);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  transition: opacity 120ms ease, border-color 120ms ease, color 120ms ease;
}

.day-empty-press {
  opacity: 0.75;
  border-color: var(--accent);
  color: var(--accent);
}

/* ---------- ③ 行程卡：时间列收窄、卡片内边距收紧，内容区更宽 ---------- */

.node {
  position: relative;
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

/* 垂直时间线轨道：贯穿上下行程项，突出旅程流动感 */
.node::before {
  content: '';
  position: absolute;
  left: 82rpx;
  top: 42rpx;
  bottom: -22rpx;
  width: 2rpx;
  background: var(--line);
  opacity: 0.6;
  pointer-events: none;
}

.node:last-child::before {
  display: none;
}

.node.dragging::before {
  opacity: 0;
}

.node-time {
  position: relative;
  width: 76rpx;
  flex: none;
  text-align: right;
  padding-top: 22rpx;
  color: var(--ink-3);
  font-size: 25rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.3rpx;
}

/* 没定时间的项：时间格写「待定」，比一个像缺字的「—」像样，卡片仍然对齐 */
.node-time.tbd {
  padding-top: 24rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 600;
}

.node-card {
  position: relative;
  flex: 1;
  min-width: 0;
  background: var(--card);
  border-radius: var(--radius);
  border: var(--card-border);
  border-left: 8rpx solid var(--line);
  padding: 22rpx 24rpx;
  box-shadow: var(--card-shadow), var(--card-highlight);
  box-sizing: border-box;
  transition: box-shadow 120ms ease, transform 120ms ease;
}

.node.current .node-card {
  box-shadow: 0 0 0 2rpx var(--accent), var(--accent-glow), var(--card-shadow-elevated);
}

/* ④ 完成不再划线：整卡略淡 + 类型行右侧的绿色小徽章（.done-badge） */
.node.done .node-card {
  opacity: 0.8;
}

.node-main {
  cursor: pointer;
}

.node-main-press {
  opacity: 0.78;
}

.node-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.node-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 类型图标：由 core/glyphs 生成 data URI（platform/wx/icons.js） */
.type-icon {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.type-name {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.node-right {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.done-badge {
  flex: none;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(16, 185, 129, 0.12);
  color: var(--ok);
  border: 1rpx solid rgba(16, 185, 129, 0.25);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.node-range {
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.node-title {
  margin-top: 8rpx;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  word-break: break-word;
}

.node-loc {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  word-break: break-word;
}

.node-spend {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

/* ---------- 待办清单（勾掉的条目保留划线，那是清单内部的事） ---------- */

.checks {
  margin-top: 14rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 命中框 88rpx（44px 标准）：整行可点，勾选不再只靠那 36rpx 的圆圈 */
  padding: 24rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 50%;
  border: 3rpx solid var(--checkbox-line);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  transition: background-color 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.checkbox.on {
  background: var(--ok-gradient);
  border-color: transparent;
  box-shadow: var(--ok-glow);
}

.check-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--ink-2);
  word-break: break-word;
}

.check-press {
  opacity: 0.65;
}

.tail {
  margin: 30rpx 0 10rpx;
  text-align: center;
  font-size: 24rpx;
}

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* ---------- 照片 ---------- */

/* 缩略图行：120rpx 的小方格换行排，一屏能扫过不少照片 */
.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

/* 路径没到时就这块底色撑住版面，图到了直接换 src，不引起跳动 */
.shot-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--surface-2, var(--line));
  border: var(--card-border);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

/* 卡片底部操作行：小胶囊风，和右边的状态色不抢注意力 */
.card-acts {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.drive-hint {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-right: auto;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 500;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.drive-ic {
  width: 26rpx;
  height: 26rpx;
  flex: none;
}

.act-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  /* 只加高不加宽：这一行 6 个胶囊本来就在换行边缘，加宽会翻车。
     WXSS 的 min-height 是 content-box 语义，必须配 border-box 才是 88rpx 总高 */
  padding: 12rpx 20rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
  transition: opacity 120ms ease, transform 120ms ease, box-shadow 120ms ease;
}

/* 相机小图标：data URI 画的，颜色随图标自己，这里只管尺寸 */
.act-ic {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.act-btn.on-accent {
  background: var(--accent-gradient);
  color: #ffffff;
  border: none;
  font-weight: 600;
  box-shadow: var(--accent-glow);
}

.act-btn.on-ok {
  background: var(--ok-gradient);
  color: #ffffff;
  border: none;
  font-weight: 600;
  box-shadow: var(--ok-glow);
}

.act-btn.done-chip {
  background: rgba(39, 174, 96, 0.12);
  color: var(--ok);
  border: 1rpx solid rgba(39, 174, 96, 0.22);
  font-weight: 600;
}

.act-press {
  opacity: 0.75;
  transform: scale(0.96);
}

/* 随手记（散照片/散账）：不属于任何一天，收在时间线末尾 */
.loose {
  margin-top: 28rpx;
}

.loose-title {
  padding: 0 4rpx 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.loose .shots {
  margin-top: 0;
}

/* ---------- 总结卡展开的明细面板（前置 / 钱） ---------- */

.panel {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.panel-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.panel-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-act {
  font-size: 24rpx;
  color: var(--accent);
  padding: 4rpx 8rpx;
}

.panel-empty {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

.brow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}

.brow-ic {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.brow-label {
  font-size: 27rpx;
}

.brow-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.brow-amt {
  margin-left: 16rpx;
  min-width: 130rpx;
  text-align: right;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.split {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.split-title {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}

.prow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex: none;
}

.prow-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prow-amt {
  font-size: 27rpx;
  font-variant-numeric: tabular-nums;
}

.panel-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.foot-note {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-3);
}

.foot-note.danger {
  color: var(--danger);
}

.foot-btn {
  font-size: 26rpx;
  color: var(--accent);
  /* 命中框撑到 88rpx：增量用等量负 margin 抵回，占位与文字坐标不变 */
  padding: 26rpx 20rpx;
  margin: -22rpx -12rpx;
}

/* ---------- 卡片里的账目行 ---------- */

.money {
  margin-top: 12rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}

.mrow-press {
  opacity: 0.65;
}

.mrow-ic {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.mrow-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mrow-amt {
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ---------- 每天的「加一项」与右下角快捷入口 ---------- */

.day-add {
  margin: -6rpx 0 18rpx 90rpx; /* 让开收窄后的时间列（76rpx + 14rpx 间距） */
  padding: 16rpx 0;
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--ink-3);
  transition: color 120ms ease, opacity 120ms ease;
}

.day-add-press {
  color: var(--accent);
  opacity: 0.8;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--accent-gradient);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(43, 119, 229, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  z-index: 20;
  transition: transform 120ms ease, box-shadow 120ms ease, opacity 120ms ease;
}

.fab-press {
  opacity: 0.9;
  transform: scale(0.92);
  box-shadow: 0 4rpx 14rpx rgba(43, 119, 229, 0.35);
}

/* ---------- ⑤ 长按拖动 v2：迷你卡 + 虚线占位 ---------- */

/* 页面本身不再滚：内容整体交给 scroll-view，拖动/确认面板时锁滚动、自己控制 scrollTop */
.timeline {
  box-sizing: border-box;
  height: 100vh;
  padding: 0;
  overflow: hidden;
}

.scroll {
  height: 100%;
}

.scroll-inner {
  padding: 22rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 被捏起来的原卡不再放大跟手：原地留虚线框，视觉交给 fixed 的迷你卡 */
.node.dragging {
  position: relative;
  z-index: 10;
}

.node.dragging .node-card {
  visibility: hidden;
}

/* 原位占位：迷你卡跟手走了，留一条虚线框告诉用户它从哪儿来 */
.drag-ghost {
  position: absolute;
  left: 90rpx; /* 让开收窄后的时间列（76rpx + 14rpx 间距） */
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx dashed var(--accent);
  border-radius: var(--radius);
  background: var(--accent-soft);
  opacity: 0.45;
}

/* 迷你拖拽卡：一条小卡，fixed 跟着手指纵向走（top 由行内样式给） */
.drag-card {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 45;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: var(--card);
  border-radius: 18rpx;
  border-left: 6rpx solid var(--accent);
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.28);
  pointer-events: none;
}

.drag-ic {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.drag-time {
  flex: none;
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.drag-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 插入指示线：fixed 在视口里，跟着落点上下走 */
.drop-line {
  position: fixed;
  left: 26rpx;
  right: 26rpx;
  height: 6rpx;
  margin-top: -3rpx;
  border-radius: 999rpx;
  background: var(--accent);
  box-shadow: 0 0 0 6rpx var(--accent-soft);
  z-index: 40;
  pointer-events: none;
}

/* ---------- ⑥ 落点确认面板 ---------- */

.drop-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}

.drop-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(16, 24, 40, 0.25);
  border-top: var(--card-border);
}

.ds-head {
  font-size: 24rpx;
  color: var(--ink-3);
}

.ds-day {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
}

.ds-list {
  max-height: 46vh;
  margin-top: 14rpx;
}

.drop-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
}

/* 被拖项高亮：放到哪儿一眼可见 */
.drop-row.on {
  background: var(--accent-soft);
  box-shadow: 0 0 0 2rpx var(--accent), var(--accent-glow);
}

.drop-ic {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.drop-time {
  width: 96rpx;
  flex: none;
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.drop-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 试算顺延了时间的项：一个小标记 */
.time-moved {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
}

.ds-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.ds-acts {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.drop-cancel {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 22rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  transition: opacity 120ms ease, transform 120ms ease;
}

.drop-ok {
  flex: 2;
  padding: 22rpx 0;
  border-radius: 22rpx;
  background: var(--accent-gradient);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: var(--accent-glow);
  transition: opacity 120ms ease, transform 120ms ease;
}

.drop-ok.busy {
  opacity: 0.6;
}

.ds-press {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ---------- ⑦ 行程切换胶囊 & 只读横幅 ---------- */

.trip-switcher-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
}

.trip-switcher-title {
  font-weight: 700;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-role-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #fef3e6;
  color: #f2994a;
}

.trip-switcher-arrow {
  font-size: 20rpx;
  color: var(--ink-3);
}

.readonly-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fef3e6;
  border: 1rpx solid rgba(242, 153, 74, 0.3);
  border-radius: 16rpx;
}

.readonly-text {
  font-size: 26rpx;
  color: #f2994a;
  font-weight: 600;
}

.readonly-clone-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  background: #f2994a;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ---------- ⑧ 多时间线半屏抽屉 & 模态弹窗 ---------- */

.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.drawer-sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--surface-1);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink-1);
}

.drawer-close {
  font-size: 36rpx;
  color: var(--ink-3);
  padding: 8rpx 16rpx;
}

.drawer-trip-list {
  max-height: 50vh;
  margin: 20rpx 0;
}

.drawer-trip-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--surface-2);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line);
}

.drawer-trip-card.is-active {
  border-color: #2f80ed;
  background: #f0f7ff;
}

.drawer-trip-main {
  flex: 1;
}

.drawer-trip-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.drawer-trip-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-1);
}

.drawer-trip-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--line);
  color: var(--ink-2);
}

.drawer-trip-meta {
  font-size: 24rpx;
  color: var(--ink-3);
}

.drawer-trip-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #2f80ed;
}

.drawer-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.drawer-btn {
  width: 100% !important;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary {
  background: #2f80ed;
  color: #ffffff;
}

.btn-secondary {
  background: #f0f7ff;
  color: #2f80ed;
  border: 1rpx solid rgba(47, 128, 237, 0.3);
}

.btn-outline {
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
}

/* 弹窗居中 */
.modal-mask {
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  background: var(--surface-1);
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.form-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--ink-2);
}

.form-input {
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.btn-sm {
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
}

.preview-box {
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.preview-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.preview-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
}

.preview-role-tag {
  background: #e8f7ef;
  color: #27ae60;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.preview-subtitle {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.claim-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.claim-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-1);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--ink-1);
}

.claim-chip.is-selected {
  border-color: #2f80ed;
  background: #2f80ed;
  color: #ffffff;
}

