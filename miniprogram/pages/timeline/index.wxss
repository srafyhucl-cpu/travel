.hud {
  margin-bottom: 10rpx;
}

.now {
  background: var(--card);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  border-left: 8rpx solid var(--accent);
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.now.tone-active {
  border-left-color: var(--accent);
}

.now.tone-done {
  border-left-color: var(--ok);
}

.now.tone-upcoming {
  border-left-color: var(--accent);
}

.now-label {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.now.tone-done .now-label {
  color: var(--ok);
}

.now-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.now-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.flags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.flag-link {
  margin-left: auto;
  padding: 4rpx 8rpx;
  font-size: 24rpx;
  color: var(--accent);
}

.flag {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
}

.flag.off {
  background: rgba(226, 87, 76, 0.12);
  color: var(--danger);
}

.day {
  margin-top: 28rpx;
}

.day-mark {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 0 4rpx 14rpx;
}

.dm-date {
  font-size: 30rpx;
  font-weight: 700;
}

.day-mark.today .dm-date {
  color: var(--accent);
}

.dm-rel {
  font-size: 24rpx;
  color: var(--ink-3);
}

.dm-count {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-3);
}

.day-empty {
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius);
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}

.node {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.node-time {
  width: 118rpx;
  flex: none;
  text-align: right;
  padding-top: 22rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

.node-card {
  flex: 1;
  min-width: 0;
  background: var(--card);
  border-radius: var(--radius);
  border-left: 8rpx solid var(--line);
  padding: 22rpx 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.node.current .node-card {
  box-shadow: 0 0 0 2rpx var(--accent-soft), 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.node.done .node-card {
  opacity: 0.72;
}

.node-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.type-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

/* 类型图标：由 core/glyphs 生成 data URI（platform/wx/icons.js） */
.type-icon {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

/* 深色下复选框的描边要提亮，不然跟卡片糊在一起 */
@media (prefers-color-scheme: dark) {
  .checkbox {
    border-color: rgba(255, 255, 255, 0.35);
  }
}

.type-name {
  font-size: 24rpx;
  font-weight: 600;
}

.node-range {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.node-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.node-loc {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.checks {
  margin-top: 12rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 50%;
  border: 3rpx solid rgba(17, 24, 39, 0.25);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
}

.checkbox.on {
  background: var(--ok);
  border-color: var(--ok);
}

.check-text {
  font-size: 27rpx;
  color: var(--ink-2);
}

.tail {
  margin: 30rpx 0 10rpx;
  text-align: center;
}

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* ---------- 照片 ---------- */

/* 缩略图行：120rpx 的小方格换行排，一屏能扫过不少照片 */
.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

/* 路径没到时就这块底色撑住版面，图到了直接换 src，不引起跳动。
   app.wxss 还没有 --surface-2 变量，退回 --line（深浅两套都有值）当占位色 */
.shot-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: var(--surface-2, var(--line));
}

/* 卡片底部操作行：小胶囊风，和右边的状态色不抢注意力 */
.card-acts {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.act-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-2, var(--line));
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.4;
}

/* 相机小图标：data URI 画的，颜色随图标自己，这里只管尺寸 */
.act-ic {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

/* 随手记（散照片）：不属于任何一天，收在时间线末尾 */
.loose {
  margin-top: 28rpx;
}

.loose-title {
  padding: 0 4rpx 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.loose .shots {
  margin-top: 0;
}

/* ---------- Deck：前置 / 钱 两格 ---------- */

.segs {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.seg {
  flex: 1;
  min-width: 0;
  background: var(--card);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.seg.open {
  border-color: var(--accent-soft);
}

.seg-l1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.seg-ic {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.seg-label {
  font-size: 24rpx;
  color: var(--ink-2);
}

.seg-num {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.seg.ok .seg-num {
  color: var(--ok);
}

.seg-num.danger {
  color: var(--danger);
}

.seg-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.bar {
  margin-top: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface-2, var(--line));
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

.seg.ok .bar-fill {
  background: var(--ok);
}

.seg.over .bar-fill {
  background: var(--danger);
}

/* Deck 展开的明细面板 */
.panel {
  margin-top: 14rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 22rpx 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}

.panel-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.panel-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-act {
  font-size: 24rpx;
  color: var(--accent);
  padding: 4rpx 8rpx;
}

.panel-empty {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

.brow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}

.brow-ic {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.brow-label {
  font-size: 27rpx;
}

.brow-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
}

.brow-amt {
  margin-left: 16rpx;
  min-width: 130rpx;
  text-align: right;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.split {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.split-title {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}

.prow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex: none;
}

.prow-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prow-amt {
  font-size: 27rpx;
  font-variant-numeric: tabular-nums;
}

.panel-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.foot-note {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-3);
}

.foot-note.danger {
  color: var(--danger);
}

.foot-btn {
  font-size: 26rpx;
  color: var(--accent);
  padding: 4rpx 8rpx;
}

/* ---------- 卡片头 / 账目行 / 打卡 ---------- */

.node-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.node-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.node-right {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.node-right .node-range {
  margin-left: 0;
}

.node-spend {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}

.money {
  margin-top: 12rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}

.mrow-ic {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.mrow-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mrow-amt {
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.act-btn.on-accent {
  background: var(--accent);
  color: #ffffff;
}

.act-btn.on-ok {
  background: var(--ok);
  color: #ffffff;
}

.act-btn.done-chip {
  background: rgba(39, 174, 96, 0.12);
  color: var(--ok);
}

/* ---------- 每天的「加一项」与右下角快捷入口 ---------- */

.day-add {
  margin: -6rpx 0 18rpx 134rpx;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: var(--ink-3);
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, 0.35);
  z-index: 20;
}

.fab-press {
  opacity: 0.85;
}

/* ---------- 长按拖动排序 ---------- */

/* 页面本身不再滚：内容整体交给 scroll-view，拖动时锁滚动、自己控制 scrollTop */
.timeline {
  padding: 0;
  height: 100vh;
  overflow: hidden;
}

.scroll {
  height: 100%;
}

.scroll-inner {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 被捏起来的卡片：放大、抬阴影、半透明，随手指平移（transform 由行内样式给） */
.node.dragging {
  position: relative;
  z-index: 10;
}

.node.dragging .node-card {
  position: relative;
  z-index: 2;
  box-shadow: 0 0 0 2rpx var(--accent-soft), 0 18rpx 48rpx rgba(16, 24, 40, 0.25);
  opacity: 0.9;
}

/* 原位占位：卡片走了，留一条虚线框告诉用户它从哪儿来 */
.drag-ghost {
  position: absolute;
  left: 134rpx; /* 让开左边的时间列（118rpx + 16rpx 间距） */
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx dashed var(--accent);
  border-radius: var(--radius);
  background: var(--accent-soft);
  opacity: 0.45;
}

/* 插入指示线：fixed 在视口里，跟着落点上下走 */
.drop-line {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  height: 6rpx;
  margin-top: -3rpx;
  border-radius: 999rpx;
  background: var(--accent);
  box-shadow: 0 0 0 6rpx var(--accent-soft);
  z-index: 40;
  pointer-events: none;
}
