<view class="page">
  <block wx:if="{{ready}}">
    <view class="hud">
      <view class="now tone-{{now.tone}}">
        <view class="now-label">{{now.label}}</view>
        <view class="now-title">{{now.title}}</view>
        <view class="now-sub">{{now.sub}}</view>
      </view>
      <view class="flags">
        <text wx:if="{{!online}}" class="flag off">离线中</text>
        <text wx:elif="{{syncing}}" class="flag">同步中…</text>
      </view>
    </view>

    <view wx:for="{{days}}" wx:key="date" class="day">
      <view class="day-mark {{item.isToday ? 'today' : ''}}">
        <text class="dm-date">{{item.label}}</text>
        <text class="dm-rel">{{item.rel}}</text>
        <text class="dm-count">{{item.done}}/{{item.total}}</text>
      </view>

      <view wx:if="{{item.total === 0}}" class="day-empty">这天还没安排</view>

      <view
        wx:for="{{item.nodes}}"
        wx:for-item="n"
        wx:key="id"
        class="node {{n.done ? 'done' : ''}} {{n.current ? 'current' : ''}}"
      >
        <view class="node-time">{{n.time}}</view>
        <view class="node-card" style="border-left-color:{{n.typeColor}}">
          <view class="node-meta">
            <image class="type-icon" src="{{n.icon}}" mode="aspectFit" />
            <text class="type-name" style="color:{{n.typeColor}}">{{n.typeLabel}}</text>
            <text wx:if="{{n.range}}" class="node-range">{{n.range}}</text>
          </view>
          <view class="node-title {{n.done ? 'strike' : ''}}">{{n.title}}</view>
          <view wx:if="{{n.location}}" class="node-loc">{{n.location}}</view>

          <!-- 这趟节点下的照片：缩略图路径由页面逐张回填，src 为空时就是一块占位底色 -->
          <view wx:if="{{n.photos.length}}" class="shots">
            <image
              wx:for="{{n.photos}}"
              wx:for-item="p"
              wx:key="id"
              class="shot-thumb"
              src="{{photoPaths[p.id]}}"
              mode="aspectFill"
              data-group="n:{{n.id}}"
              data-pid="{{p.id}}"
              bindtap="onPhoto"
              bindlongpress="onPhotoLong"
            />
          </view>

          <view wx:if="{{n.checklist.length}}" class="checks">
            <view
              wx:for="{{n.checklist}}"
              wx:for-item="c"
              wx:key="id"
              class="check-row"
              data-node="{{n.id}}"
              data-item="{{c.id}}"
              data-done="{{c.done}}"
              data-text="{{c.text}}"
              bindtap="onToggle"
            >
              <view class="checkbox {{c.done ? 'on' : ''}}">{{c.done ? '✓' : ''}}</view>
              <text class="check-text {{c.done ? 'strike' : ''}}">{{c.text}}</text>
            </view>
          </view>

          <!-- 卡片底部的附加操作：跟待办、地点一样是这张卡的附注，不抢标题的视线 -->
          <view class="card-acts">
            <view class="act-btn" data-id="{{n.id}}" bindtap="onAddPhoto"><image class="act-ic" src="{{cameraIcon}}" mode="aspectFit" />照片</view>
            <view class="act-btn" data-id="{{n.id}}" bindtap="onAddExpense"><image class="act-ic" src="{{walletIcon}}" mode="aspectFit" />记一笔</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 不属于任何节点的散照片（随手拍），收在时间线末尾 -->
    <view wx:if="{{loose.length}}" class="loose">
      <view class="loose-title">随手记 · 照片</view>
      <view class="shots">
        <image
          wx:for="{{loose}}"
          wx:for-item="p"
          wx:key="id"
          class="shot-thumb"
          src="{{photoPaths[p.id]}}"
          mode="aspectFill"
          data-group="loose"
          data-pid="{{p.id}}"
          bindtap="onPhoto"
          bindlongpress="onPhotoLong"
        />
      </view>
    </view>

    <view class="tail muted">下拉刷新 · 每 20 秒自动同步</view>
  </block>

  <view wx:else class="loading">
    <view class="loading-title">正在打开…</view>
    <view class="muted">首次进入会从服务器加载这趟旅行</view>
  </view>
</view>
