/* vlog 出图：选项卡片 + 画布预览 */

.sec {
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill-row.sub {
  margin-top: 16rpx;
}

.pill {
  flex: none;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease, background-color 120ms ease;
}

.pill.on {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 700;
  box-shadow: 0 2rpx 12rpx rgba(43, 119, 229, 0.18);
}

/* 条件不满足的胶囊（没照片/张数不够）：点不动，也看不出能点 */
.pill.off {
  color: var(--ink-3);
  opacity: 0.5;
}

.field {
  margin-top: 24rpx;
}

.field .label {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.row-between {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.hint {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.input {
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--surface-2);
  border: var(--card-border);
  border-radius: 18rpx;
  font-size: 29rpx;
  box-sizing: border-box;
}

.swatches {
  display: flex;
  gap: 16rpx;
}

.swatch {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: transform 120ms ease, opacity 120ms ease, box-shadow 120ms ease;
}

.swatch.on {
  border-color: var(--card);
  transform: scale(1.12);
  box-shadow: 0 0 0 4rpx var(--card), 0 0 0 8rpx var(--accent), 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
}

/* 预览：画布本体就是预览图（物理像素高、样式尺寸小） */
.preview {
  position: relative;
  padding: 16rpx;
  display: flex;
  justify-content: center;
  border: var(--card-border);
  box-shadow: var(--card-shadow-elevated), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.cv {
  border-radius: 12rpx;
  background: var(--surface-2, var(--line));
}

.mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  background: rgba(0, 0, 0, 0.35);
  color: #ffffff;
  font-size: 27rpx;
}

.acts {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

button.btn-primary[disabled] {
  background: var(--surface-2);
  color: var(--ink-3);
  box-shadow: none;
  opacity: 0.6;
}

.btn-plain {
  margin-top: 0;
  background: var(--card);
  border: var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 2.5;
  color: var(--ink-2);
  transition: opacity 120ms ease, transform 120ms ease;
}

.btn-plain[disabled] {
  opacity: 0.5;
}

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
