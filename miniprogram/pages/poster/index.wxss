/* vlog 出图：选项卡片 + 画布预览 */

.sec {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill-row.sub {
  margin-top: 16rpx;
}

.pill {
  flex: none;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid transparent;
  background: var(--surface-2, var(--line));
  color: var(--ink-2);
  font-size: 26rpx;
}

.pill.on {
  background: var(--card);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

.field {
  margin-top: 24rpx;
}

.field .label {
  display: block;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.row-between {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.hint {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.input {
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--bg);
  border-radius: 18rpx;
  font-size: 29rpx;
}

.swatches {
  display: flex;
  gap: 16rpx;
}

.swatch {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.swatch.on {
  border-color: var(--card);
  box-shadow: 0 0 0 3rpx var(--ink-3);
}

/* 预览：画布本体就是预览图（物理像素高、样式尺寸小） */
.preview {
  position: relative;
  padding: 12rpx;
  display: flex;
  justify-content: center;
}

.cv {
  border-radius: 12rpx;
  background: var(--surface-2, var(--line));
}

.mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  background: rgba(0, 0, 0, 0.35);
  color: #ffffff;
  font-size: 27rpx;
}

.acts {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

button.btn-primary[disabled] {
  background: var(--accent);
  color: #ffffff;
  opacity: 0.55;
}

.btn-plain {
  margin-top: 0;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 2.5;
  color: var(--ink-2);
}

.btn-plain[disabled] {
  opacity: 0.5;
}

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
