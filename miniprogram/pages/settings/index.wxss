/* 「我的」设置页：卡片 + 内联小表单；颜色全走 tokens（深色自适应） */

.sec {
  padding: 26rpx 30rpx;
  margin-bottom: 16rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.strong {
  font-size: 30rpx;
  font-weight: 700;
}

.tiny {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.trip-name {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  word-break: break-word;
}

.stats-line {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  font-size: 23rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

/* 小节标题 + 右侧动作 */
.sec-title {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 26rpx 6rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.sec-act {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--accent);
}

.sub-title {
  margin: 18rpx 0 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ------------------------------ 通用小件 ------------------------------ */

.chip {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--surface-2, var(--line));
  color: var(--ink-2);
  font-size: 25rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.chip.sm {
  padding: 6rpx 18rpx;
  font-size: 23rpx;
}

.chip.danger {
  color: var(--danger);
}

.chip.add {
  color: var(--accent);
}

.chip.mgr {
  display: inline-block;
  margin-top: 16rpx;
}

.soft-chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
  transition: opacity 120ms ease;
}

.cat-row:last-of-type {
  border-bottom: none;
}

.chev {
  flex: none;
  color: var(--ink-3);
  font-size: 30rpx;
}

/* ------------------------------ 表单 ------------------------------ */

.sub-form {
  margin-top: 16rpx;
  padding: 24rpx;
  background: var(--surface-2);
  border: var(--card-border);
  border-radius: 20rpx;
}

.sub-form .field {
  margin-top: 18rpx;
}

.sub-form .field:first-child {
  margin-top: 0;
}

.field .label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}

.input {
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--card);
  border: var(--card-border);
  border-radius: 18rpx;
  font-size: 29rpx;
  box-sizing: border-box;
}

.grid2 {
  display: flex;
  gap: 18rpx;
}

.grid2 .field {
  flex: 1;
  min-width: 0;
}

.picker-trigger {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  background: var(--card);
  border: var(--card-border);
  border-radius: 18rpx;
  font-size: 29rpx;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}

.picker-trigger.empty {
  color: var(--ink-3);
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

button.btn-primary.sm {
  margin-top: 0;
  font-size: 29rpx;
  line-height: 2.3;
}

button.btn-primary[disabled] {
  background: var(--surface-2);
  color: var(--ink-3);
  box-shadow: none;
  opacity: 0.6;
}

.btn-plain {
  flex: none;
  margin-top: 0;
  padding: 0 30rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  font-size: 29rpx;
  line-height: 2.3;
  color: var(--ink-2);
  transition: opacity 120ms ease, transform 120ms ease;
}

.btn-danger {
  margin-top: 24rpx;
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 2.4;
  transition: opacity 120ms ease, transform 120ms ease;
}

.err {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--danger);
}

/* ------------------------------ 成员 ------------------------------ */

.member-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 0;
}

.avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 64rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.me-tag {
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.12);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.member-edit {
  padding: 14rpx 0;
}

.swatches {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.swatch {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.swatch.on {
  border-color: var(--card);
  box-shadow: 0 0 0 3rpx var(--ink-3);
}

/* ------------------------------ 词汇 ------------------------------ */

.custom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.icongrid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.iconcell {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.iconcell.on {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.icon-img {
  width: 44rpx;
  height: 44rpx;
}

/* ------------------------------ 尾部 ------------------------------ */

.foot {
  margin: 28rpx 6rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* -------------------- 微信个人资料卡 -------------------- */
.profile-card {
  padding: 28rpx 30rpx 20rpx;
}

.profile-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-user-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.switch-account-link {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  white-space: nowrap;
  flex-shrink: 0;
}

.link-press {
  opacity: 0.7;
}

.profile-divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0 16rpx;
}

.achv-entry {
  padding: 8rpx 0 4rpx;
}

.achv-title {
  color: var(--ink);
  font-size: 28rpx;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  display: none;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent);
}

.avatar-fallback {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  border: 3rpx solid var(--line);
}

.avatar-tip {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.profile-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname-input {
  font-weight: 600;
  font-size: 30rpx;
}

/* -------------------- 成员状态与虚拟同伴 -------------------- */
.sec-act-group {
  margin-left: auto;
  display: flex;
  gap: 20rpx;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-sub-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  height: 40rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 8rpx;
  white-space: nowrap;
  margin-top: 6rpx;
}

.badge-virtual {
  background: rgba(242, 153, 74, 0.12);
  color: #F2994A;
}

.badge-real {
  background: rgba(39, 174, 96, 0.12);
  color: #27AE60;
}

.del-member-btn {
  color: var(--danger);
  font-size: 28rpx;
  padding: 8rpx 14rpx;
}

/* -------------------- 协作与分享 -------------------- */
.share-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.share-desc {
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.share-actions {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
}

.share-actions .share-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
  height: 84rpx;
  padding: 0 16rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1 !important;
  white-space: nowrap;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.member-divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0 20rpx;
}

.code-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.code-copy-pill {
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1rpx solid rgba(47, 128, 237, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* -------------------- 高级设置 Accordion -------------------- */
.accordion-card {
  padding: 0 30rpx;
}

.accordion-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 24rpx 0;
  box-sizing: border-box;
  gap: 20rpx;
}

.acc-press {
  opacity: 0.7;
}

.accordion-toggle {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
  flex-shrink: 0;
}

.accordion-body {
  padding: 8rpx 0 24rpx;
  border-top: 1rpx dashed var(--line);
}

.accordion-divider {
  height: 1rpx;
  background: var(--line);
}

/* -------------------- 行程状态与分支 -------------------- */
.status-chips {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.status-pill {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 16rpx;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--surface-2);
  color: var(--ink-2);
  border: 1rpx solid transparent;
  transition: all 150ms ease;
}

.status-pill.on {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}

.status-pill.disabled {
  opacity: 0.6;
}

.branch-section {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.delete-trip-btn {
  margin-top: 24rpx;
  width: 100%;
}

/* -------------------- 弹窗样式 -------------------- */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 600rpx;
  background: var(--card);
  border-radius: 30rpx;
  padding: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.modal-input {
  margin-bottom: 28rpx;
}

