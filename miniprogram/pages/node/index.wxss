/* 行程编辑：和记账页同一套表单语言（卡片、胶囊、字段），颜色全走 tokens */
.form {
  padding: 12rpx 32rpx 40rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.req {
  font-size: 22rpx;
  color: var(--danger);
  font-weight: 700;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

.row-between {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ------------------------------ 待办 ------------------------------ */

.check-edit {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 0;
}

.check-edit .checkbox {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 50%;
  border: 3rpx solid var(--checkbox-line);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  transition: background-color 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.check-edit .checkbox.on {
  background: var(--ok-gradient);
  border-color: transparent;
  box-shadow: var(--ok-glow);
}

.check-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  background: var(--surface-2);
  border: var(--card-border);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.check-del {
  flex: none;
  padding: 21rpx 14rpx;
  margin: -13rpx 0;
  color: var(--ink-3);
  font-size: 28rpx;
  transition: opacity 120ms ease, color 120ms ease;
}

.check-add {
  margin-top: 6rpx;
  padding: 16rpx 0;
  min-height: 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}

/* ------------------------------ 胶囊（与记账页同款） ------------------------------ */

.pill-scroll {
  display: flex;
  flex-wrap: nowrap;
}

.pill-scroll .pill {
  margin: 0 14rpx 0 0;
}

.pill {
  flex: none;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease, background-color 120ms ease;
}

.pill.on {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 700;
  box-shadow: 0 2rpx 12rpx rgba(43, 119, 229, 0.18);
}

/* 行程类型胶囊：保留类型本色，底托卡片色凸显描边与文字质感 */
.pill-scroll .pill.on {
  background: var(--card);
  border-color: currentColor;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.pill-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

/* ------------------------------ 日期 / 时间 ------------------------------ */

.grid2 {
  display: flex;
  gap: 20rpx;
}

.grid2 .field {
  flex: 1;
  min-width: 0;
}

.picker-trigger {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  background: var(--surface-2);
  border: var(--card-border);
  border-radius: 20rpx;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}

.picker-trigger.empty {
  color: var(--ink-3);
}

.time-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-row .grow {
  flex: 1;
  min-width: 0;
}

.clear {
  flex: none;
  padding: 18rpx 16rpx;
  margin: -10rpx -6rpx;
  color: var(--ink-3);
  font-size: 28rpx;
  border-radius: 50%;
}

/* ------------------------------ 地点 ------------------------------ */

.label-row {
  display: flex;
  align-items: center;
}

.label-row .label {
  flex: 1;
  margin-bottom: 10rpx;
}

.field-act {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 10rpx 14rpx;
  margin: -6rpx -6rpx 4rpx 0;
  border-radius: 12rpx;
}

.field-act.on {
  color: var(--accent);
}

.input-sub {
  margin-top: 12rpx;
}

/* ------------------------------ 按钮 ------------------------------ */

.form .input {
  background: var(--surface-2);
  border: var(--card-border);
}

button.btn-primary[disabled] {
  background: var(--surface-2);
  color: var(--ink-3);
  box-shadow: none;
  opacity: 0.6;
}

.req-missing {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--danger);
}

.btn-danger {
  margin-top: 20rpx;
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 2.4;
  transition: opacity 120ms ease, transform 120ms ease;
}

/* ------------------------------ 加载 ------------------------------ */

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* ------------------------------ 地图选点 ------------------------------ */

.map-wrap {
  position: relative;
  margin-top: 12rpx;
}

.map-stage {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.pick-map {
  width: 100%;
  height: 100%;
}

/* 地图中心十字准星：悬浮在地图正中央，半透明光晕强化对比，不挡手指拖动 */
.map-crosshair {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  pointer-events: none;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cross-h {
  position: absolute;
  width: 36rpx;
  height: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
}

.cross-v {
  position: absolute;
  width: 4rpx;
  height: 36rpx;
  background: var(--accent);
  border-radius: 2rpx;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
}

.cross-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 3rpx solid var(--accent);
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
  z-index: 2;
}

.map-tip {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.map-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.map-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: var(--card);
  color: var(--accent);
  border: 2rpx solid var(--accent);
}

.map-btn.off {
  color: var(--ink-3);
  border-color: var(--ink-3);
}
