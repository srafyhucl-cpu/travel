<view class="page">
  <view wx:if="{{ready}}" class="card form">
    <view class="form-title">{{editing ? '改这笔' : '记一笔'}}</view>

    <view class="field">
      <text class="label">金额</text>
      <view class="amount-row">
        <text class="amount-cur">¥</text>
        <input
          class="amount-input"
          type="digit"
          value="{{amount}}"
          focus="{{ready && !editing}}"
          placeholder="0"
          placeholder-class="amount-ph"
          bindinput="onAmount"
        />
      </view>
    </view>

    <view class="field">
      <text class="label">类别</text>
      <scroll-view class="pill-scroll" scroll-x enable-flex>
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="pill {{item.on ? 'on' : ''}}"
          style="{{item.on ? 'color:' + item.color + ';border-color:' + item.color : ''}}"
          hover-class="pill-press"
          data-key="{{item.key}}"
          bindtap="onCategory"
        >
          <image class="pill-icon" src="{{item.icon}}" mode="aspectFit" />
          <text>{{item.label}}</text>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{payers.length > 1}}" class="field">
      <text class="label">谁付的</text>
      <view class="pill-row">
        <view
          wx:for="{{payers}}"
          wx:key="id"
          class="pill {{item.on ? 'on' : ''}}"
          hover-class="pill-press"
          data-name="{{item.name}}"
          bindtap="onPayer"
        >
          <text>{{item.name}}</text>
          <text wx:if="{{item.me}}" class="me-tag">我</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="label">时间</text>
      <view class="time-row">
        <picker class="time-date" mode="date" value="{{date}}" bindchange="onDate">
          <view class="picker-trigger">{{date}}</view>
        </picker>
        <picker class="time-time" mode="time" value="{{time}}" bindchange="onTime">
          <view class="picker-trigger">{{time}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <text class="label">挂在</text>
      <view class="node-field {{nodeTitle ? '' : 'empty'}}" hover-class="pill-press" bindtap="onPickNode">
        <text class="node-field-text">{{nodeTitle || '不指定'}}</text>
        <text class="node-field-chev">›</text>
      </view>
    </view>

    <view class="field">
      <text class="label">备注</text>
      <input
        class="input"
        value="{{note}}"
        placeholder="买了什么（可不填）"
        maxlength="200"
        bindinput="onNote"
      />
    </view>

    <button
      class="btn-primary {{canSave ? '' : 'off'}}"
      hover-class="{{canSave ? 'btn-press' : 'none'}}"
      disabled="{{!canSave}}"
      bindtap="onSave"
    >{{editing ? '保存' : '记下'}}</button>

    <button wx:if="{{editing}}" class="btn-danger" hover-class="btn-press" bindtap="onDelete">删掉</button>
  </view>

  <view wx:else class="loading">
    <view class="loading-title">加载中…</view>
    <view class="muted">正在准备这趟旅行的数据</view>
  </view>
</view>
