/* 「记一笔」：跟时间线同一套卡片 / 胶囊语言，颜色全走 app.wxss 的 tokens（深色自适应） */

.form {
  padding: 12rpx 32rpx 40rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  border-radius: var(--radius);
  box-sizing: border-box;
}

/* 顶部一行模式提示：记一笔 / 改这笔（跟按钮文案一致，一眼知道在哪个模式） */
.form-title {
  padding: 26rpx 0 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
}

/* ------------------------------ 金额 ------------------------------ */

.amount-row {
  display: flex;
  align-items: baseline;
  border-bottom: 2rpx solid var(--line);
  padding-bottom: 8rpx;
  margin-top: 10rpx;
}

.amount-cur {
  flex: none;
  margin-right: 14rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 120rpx;
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 120rpx;
  font-variant-numeric: tabular-nums;
}

.amount-ph {
  color: var(--ink-3);
  font-weight: 700;
}

/* ------------------------------ 胶囊 ------------------------------ */

/* 类别：一行横滑，不吃两行高度（enable-flex 把 scroll-view 变成 flex 容器） */
.pill-scroll {
  display: flex;
  flex-wrap: nowrap;
}

.pill-scroll .pill {
  margin: 0 14rpx 0 0;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
}

.pill-row .pill {
  margin: 0 14rpx 14rpx 0;
}

.pill {
  flex: none;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease, background-color 120ms ease;
}

.pill.on {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 700;
  box-shadow: 0 2rpx 12rpx rgba(43, 119, 229, 0.18);
}

/* 类别胶囊：有自己专属的语义色，不强制套蓝色背景，底托卡片色凸显描边与文字质感 */
.pill-scroll .pill.on {
  background: var(--card);
  border-color: currentColor;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.pill-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

/* 当前登录的人：名字后面的小胶囊（名字本来就叫「我」时不加） */
.me-tag {
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.12);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
}

/* 备注框坐在卡片上：用页面底色做内嵌感 */
.form .input {
  background: var(--surface-2);
  border: var(--card-border);
}

/* ------------------------------ 时间 / 挂在 ------------------------------ */

/* 日期 + 时间并排一行：两个原生 picker，样子跟其它表单框一致 */
.time-row {
  display: flex;
  gap: 20rpx;
}

.time-date,
.time-time {
  flex: 1;
  min-width: 0;
}

.picker-trigger {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  background: var(--surface-2);
  border: var(--card-border);
  border-radius: 20rpx;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}

/* 挂在：整行可点，点开节点选择页；没挂时显示「不指定」并淡下去 */
.node-field {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  background: var(--surface-2);
  border: var(--card-border);
  border-radius: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.node-field-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.node-field.empty .node-field-text {
  color: var(--ink-3);
}

.node-field-chev {
  flex: none;
  margin-left: 12rpx;
  color: var(--ink-3);
  font-size: 32rpx;
}

/* ------------------------------ 按钮 ------------------------------ */

/* 微信内置的 disabled 底色会盖过来，这里按 token 拽回去 */
button.btn-primary[disabled] {
  background: var(--surface-2);
  color: var(--ink-3);
  box-shadow: none;
  opacity: 0.6;
}

/* 删掉：危险色描边按钮，跟实心的「保存」拉开层级，不抢主操作 */
.btn-danger {
  margin-top: 20rpx;
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 2.4;
  transition: opacity 120ms ease, transform 120ms ease;
}

/* ------------------------------ 加载 ------------------------------ */

.loading {
  padding-top: 220rpx;
  text-align: center;
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
