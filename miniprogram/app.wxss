/* 全局 tokens 与公共样式：与 web/src/styles/tokens.css 同一套语义色 */
page {
  --bg: #f4f5f7;
  --card: #ffffff;
  --ink: #111827;
  --ink-2: #6b7280;
  --ink-3: #9ca3af;
  --line: rgba(17, 24, 39, 0.08);
  --accent: #2f80ed;
  --accent-soft: #eaf2fe;
  --ok: #27ae60;
  --danger: #e2574c;
  --radius: 26rpx;
  /* 未选中的胶囊 / 图标块的中性填充（与 web tokens 同一语义） */
  --surface-2: rgba(17, 24, 39, 0.05);
  /* 复选框描边：node/timeline 两页共用一个 token，深色自动提亮 */
  --checkbox-line: rgba(17, 24, 39, 0.25);

  /* better-ui 设计系统：多层高光倒角、层次阴影与微光渐变 */
  --accent-gradient: linear-gradient(135deg, #2b77e5 0%, #00a8ff 100%);
  --accent-glow: 0 8rpx 24rpx rgba(43, 119, 229, 0.32);
  --ok-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
  --ok-glow: 0 6rpx 20rpx rgba(16, 185, 129, 0.28);
  --badge-gold-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  --badge-gold-glow: 0 6rpx 20rpx rgba(245, 158, 11, 0.28);
  --card-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05), 0 1rpx 3rpx rgba(15, 23, 42, 0.03);
  --card-shadow-elevated: 0 10rpx 32rpx rgba(15, 23, 42, 0.08), 0 2rpx 6rpx rgba(15, 23, 42, 0.04);
  --card-border: 1rpx solid rgba(17, 24, 39, 0.06);
  --card-highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  --glass-bg: rgba(255, 255, 255, 0.88);
  --hero-bg: linear-gradient(160deg, #ffffff 0%, #f4f8fe 100%);
  --stat-card-bg: rgba(17, 24, 39, 0.03);
  --stat-card-border: 1rpx solid rgba(17, 24, 39, 0.05);

  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
}

/* 深色模式：与 Web 的 tokens 同一套值（见 web/src/styles/tokens.css）。
   app.json 里开了 darkmode + theme.json，导航栏/页面底色由微信按偏好自动切。 */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #0b0d11;
    --card: #161a22;
    --ink: #e8eaef;
    --ink-2: #a0a6b0;
    --ink-3: #6e747e;
    --line: rgba(255, 255, 255, 0.09);
    --accent: #4b93f2;
    --accent-soft: rgba(75, 147, 242, 0.16);
    --ok: #3dbb70;
    --danger: #ef6b60;
    --surface-2: rgba(255, 255, 255, 0.07);
    --checkbox-line: rgba(255, 255, 255, 0.35);

    /* better-ui 深色赛博质感：深邃层次与发光边缘 */
    --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    --accent-glow: 0 8rpx 28rpx rgba(59, 130, 246, 0.42);
    --ok-gradient: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    --ok-glow: 0 6rpx 22rpx rgba(16, 185, 129, 0.38);
    --badge-gold-gradient: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    --badge-gold-glow: 0 6rpx 22rpx rgba(245, 158, 11, 0.38);
    --card-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.5), 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
    --card-shadow-elevated: 0 14rpx 38rpx rgba(0, 0, 0, 0.65), 0 3rpx 8rpx rgba(0, 0, 0, 0.4);
    --card-border: 1rpx solid rgba(255, 255, 255, 0.08);
    --card-highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
    --glass-bg: rgba(22, 26, 34, 0.86);
    --hero-bg: linear-gradient(160deg, #161a22 0%, #121822 100%);
    --stat-card-bg: rgba(255, 255, 255, 0.04);
    --stat-card-border: 1rpx solid rgba(255, 255, 255, 0.07);
  }
}

/* 小程序 button 自带一根边框，用伪元素画出来的，统一去掉 */
button::after {
  border: none;
}

.page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-highlight);
  box-sizing: border-box;
}

.btn-primary {
  margin-top: 32rpx;
  background: var(--accent-gradient);
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 2.6;
  box-shadow: var(--accent-glow);
  transition: opacity 120ms ease, transform 120ms ease, box-shadow 120ms ease;
}

.btn-primary.off {
  opacity: 0.55;
  box-shadow: none;
}

.btn-danger {
  margin-top: 20rpx;
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 2.4;
  transition: opacity 120ms ease, transform 120ms ease, background-color 120ms ease;
}

.btn-plain {
  margin-top: 0;
  background: var(--card);
  border: var(--card-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 2.5;
  color: var(--ink-2);
  transition: opacity 120ms ease, transform 120ms ease;
}

.pill {
  transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease;
}

/* 点按反馈（微动效与触觉反馈）：全端通用微交互 token */
.btn-press {
  opacity: 0.9;
  transform: scale(0.975);
}

.pill-press {
  opacity: 0.75;
  transform: scale(0.97);
}

.picker-press {
  opacity: 0.75;
  background: var(--surface-2);
}

.cat-row-press {
  opacity: 0.72;
}

.tabular-nums {
  font-variant-numeric: tabular-nums;
}

.field {
  margin-top: 28rpx;
}

.field .label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.field .input {
  height: 84rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: var(--card-border);
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.02);
  border-radius: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.muted {
  color: var(--ink-3);
  font-size: 24rpx;
}

.strike {
  text-decoration: line-through;
  color: var(--ink-3);
}

/* 只读模式通用提示条 */
.readonly-notice {
  margin: 32rpx 0 16rpx;
  padding: 24rpx 28rpx;
  background: var(--surface-2);
  border: 1rpx dashed var(--line);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.readonly-icon {
  font-size: 36rpx;
  line-height: 1;
}

.readonly-text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.4;
  font-weight: 500;
}

